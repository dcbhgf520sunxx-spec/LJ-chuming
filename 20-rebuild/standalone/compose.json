{
  "name": "${LJAPS_STANDALONE_PROJECT:?Set a fresh deployment project name}",
  "services": {
    "mysql": {
      "image": "mysql:8.2",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${LJAPS_MYSQL_ROOT_PASSWORD}",
        "MYSQL_DATABASE": "plm7_rebuild",
        "MYSQL_USER": "${LJAPS_DB_USER}",
        "MYSQL_PASSWORD": "${LJAPS_DB_PASSWORD}",
        "TZ": "Asia/Shanghai"
      },
      "volumes": [
        "database:/var/lib/mysql",
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/database.sql.gz:/run/secrets/database.sql.gz:ro"
      ],
      "networks": [
        "isolated"
      ],
      "mem_limit": "1536m",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysql --protocol=TCP -h127.0.0.1 -uroot -N -B -e \"SELECT COUNT(*) FROM plm7_rebuild.sys_user\" >/dev/null 2>&1"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 80,
        "start_period": "15s"
      },
      "command": [
        "mysqld",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_general_ci"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c",
        "cp /run/secrets/database.sql.gz /docker-entrypoint-initdb.d/01-rebuild.sql.gz && chown mysql:mysql /docker-entrypoint-initdb.d/01-rebuild.sql.gz && chmod 0400 /docker-entrypoint-initdb.d/01-rebuild.sql.gz && exec /usr/local/bin/docker-entrypoint.sh \"$@\"",
        "--"
      ]
    },
    "redis": {
      "image": "redis:alpine",
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ],
      "volumes": [
        "redis:/data"
      ],
      "networks": {
        "isolated": {
          "aliases": [
            "rebuild-redis"
          ]
        }
      },
      "mem_limit": "256m"
    },
    "backend": {
      "image": "eclipse-temurin:8-jdk",
      "working_dir": "/app",
      "command": [
        "java",
        "-Xms128m",
        "-Xmx1536m",
        "-cp",
        "/app/app.jar:/app/modules/*:/app/lib/*",
        "com.ljaps.rebuild.RebuildApplication"
      ],
      "volumes": [
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/app:/app:ro",
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/rsa-private.pem:/run/secrets/rsa-private.pem:ro",
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/rsa-public.pem:/run/secrets/rsa-public.pem:ro",
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/business.properties:/run/config/business.properties:ro",
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/files:/data/files",
        "${LJAPS_EVIDENCE:?Set private evidence directory}:/evidence"
      ],
      "environment": {
        "TZ": "Asia/Shanghai",
        "SERVER_PORT": "8080",
        "SPRING_MAIN_BANNER_MODE": "off",
        "SPRING_DATASOURCE_URL": "jdbc:mysql://mysql:3306/plm7_rebuild?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai",
        "SPRING_DATASOURCE_USERNAME": "${LJAPS_DB_USER}",
        "SPRING_DATASOURCE_PASSWORD": "${LJAPS_DB_PASSWORD}",
        "SPRING_DATASOURCE_DRIVER_CLASS_NAME": "com.mysql.jdbc.Driver",
        "SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE": "4",
        "SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE": "1",
        "SERVER_ERROR_INCLUDE_MESSAGE": "never",
        "SERVER_ERROR_INCLUDE_STACKTRACE": "never",
        "LJAPS_RSA_PRIVATE_KEY_PATH": "/run/secrets/rsa-private.pem",
        "LJAPS_RSA_PUBLIC_KEY_PATH": "/run/secrets/rsa-public.pem",
        "LJAPS_JWT_SECRET": "${LJAPS_JWT_SECRET}",
        "LJAPS_BIM_CONFIG_AES_KEY": "${LJAPS_BIM_CONFIG_AES_KEY:-}",
        "LJAPS_INITIAL_USER_PASSWORD": "${LJAPS_INITIAL_USER_PASSWORD:?Set the private initial user password}",
        "SPRING_CONFIG_ADDITIONAL_LOCATION": "file:/run/config/business.properties",
        "SPRING_REDIS_HOST": "rebuild-redis"
      },
      "depends_on": {
        "mysql": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_started"
        }
      },
      "networks": [
        "isolated"
      ],
      "mem_limit": "3g"
    },
    "web": {
      "image": "nginx:alpine",
      "volumes": [
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/web:/usr/share/nginx/html:ro",
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "depends_on": [
        "backend"
      ],
      "networks": [
        "isolated"
      ],
      "mem_limit": "128m",
      "profiles": [
        "verification"
      ]
    },
    "gateway": {
      "image": "nginx:alpine",
      "volumes": [
        "${LJAPS_BUNDLE:?Set the prepared private bundle}/web:/usr/share/nginx/html:ro",
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "depends_on": [
        "backend"
      ],
      "networks": [
        "isolated",
        "local_entry"
      ],
      "mem_limit": "128m",
      "profiles": [
        "delivery"
      ],
      "ports": [
        "127.0.0.1:3120:80",
        "127.0.0.1:3119:81"
      ]
    }
  },
  "networks": {
    "isolated": {
      "internal": true
    },
    "local_entry": {}
  },
  "volumes": {
    "database": {},
    "redis": {}
  }
}
