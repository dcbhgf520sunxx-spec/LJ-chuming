<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.business.core.mapper.BusinessProductionControlCheckDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap"
               type="com.hzchum.scim.business.core.api.pojo.doModel.BusinessProductionControlCheckDetail">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="check_info_id" property="checkInfoId"/>
        <result column="production_control_id" property="productionControlId"/>
        <result column="old_bool_enable_enum" property="oldBoolEnableEnum"/>
        <result column="new_bool_enable_enum" property="newBoolEnableEnum"/>
        <result column="old_loss_factor" property="oldLossFactor"/>
        <result column="new_loss_factor" property="newLossFactor"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, check_info_id, production_control_id, old_bool_enable_enum, new_bool_enable_enum, old_loss_factor, new_loss_factor
    </sql>
    <select id="listByCheckId"
            resultType="com.hzchum.scim.business.core.api.pojo._do.BusinessProductionControlCheckDetailDO">
        select c.*,
               d.old_loss_factor,
               d.new_loss_factor,
               d.old_bool_enable_enum,
               d.new_bool_enable_enum
        from business_production_control_check_detail d
                 inner join business_production_control c on c.id = d.production_control_id
        where d.check_info_id = #{id}
    </select>

</mapper>
