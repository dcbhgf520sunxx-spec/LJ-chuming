<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.plan.core.mapper.TechCappCraftCardProductWeldingMapMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.plan.core.api.pojo._do.TechCappCraftCardProductWeldingMap">
        <id column="id" property="id" />
        <result column="project_id" property="projectId" />
        <result column="monomer_id" property="monomerId" />
        <result column="serial_number" property="serialNumber" />
        <result column="number" property="number" />
        <result column="dwg_num" property="dwgNum" />
        <result column="project_type" property="projectType" />
        <result column="data_type" property="dataType" />
        <result column="product_type" property="productType" />
        <result column="file_name" property="fileName" />
        <result column="file_path" property="filePath" />
        <result column="create_user_id" property="createUserId" />
        <result column="cloud_path" property="cloudPath" />
        <result column="nc1_length" property="nc1Length" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, project_id, monomer_id, serial_number, number, dwg_num, project_type, data_type, product_type, file_name, file_path, create_user_id, cloud_path, nc1_length
    </sql>
    <select id="getByMonomerIdAndTypeAndSerialNumber"
            resultType="com.hzchum.scim.plan.core.api.pojo._do.TechCappCraftCardProductWeldingMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tech_capp_craft_card_product_welding_map
        WHERE bool_delete_enum = 0
        AND monomer_id = #{monomerId}
        AND data_type = #{dataType}
        <if test="areaId != null">
            AND area_id = #{areaId}
        </if>
        <if test="productType != null">
            AND product_type = #{productType}
        </if>
        <if test="number != null">
            AND number = #{number}
        </if>
        <if test="number == null">
            AND number is null
        </if>
        AND serial_number = #{serialNumber}


    </select>

</mapper>
