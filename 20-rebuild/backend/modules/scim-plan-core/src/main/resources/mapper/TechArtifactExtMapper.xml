<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.plan.core.mapper.TechArtifactExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.plan.core.api.pojo._do.TechArtifactExt">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="project_id" property="projectId" />
        <result column="monomer_id" property="monomerId" />
        <result column="area_id" property="areaId" />
        <result column="artifact_id" property="artifactId" />
        <result column="serial_number" property="serialNumber" />
        <result column="sort_number" property="sortNumber" />
        <result column="bool_status_enum" property="boolStatusEnum" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, project_id, monomer_id, area_id, artifact_id, serial_number, sort_number, bool_status_enum
    </sql>
    <select id="listArtifact" resultType="com.hzchum.scim.plan.core.api.pojo._do.TechArtifactExt">
        SELECT
        *
        FROM
        tech_artifact_ext
        WHERE

        <if test="NumberInfos!=null and NumberInfos.size() != 0">
            <foreach collection="NumberInfos" item="NumberInfo" separator="or" open="(" close=")">
                ( artifact_id= #{NumberInfo.productId}
                and sort_number=#{NumberInfo.number})
            </foreach>
        </if>
        and bool_delete_enum = 0
    </select>


    <select id="listAllArtifactExt" resultType="com.hzchum.scim.plan.core.api.pojo._do.TechArtifactExt">
        SELECT
        *
        FROM
        tech_artifact_ext
        WHERE
        monomer_id = #{monomerId}
        <if test="serialNumberList != null and serialNumberList.size() > 0">
            and serial_number in
            <foreach collection="serialNumberList" open="(" separator="," close=")" item="serialNumber">
                #{serialNumber}
            </foreach>
        </if>

    </select>

</mapper>
