<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.plan.core.mapper.EnclosurePlanMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.plan.core.api.pojo._do.EnclosurePlan">
        <id column="id" property="id"/>
        <result column="tech_id" property="techId"/>
        <result column="quantity_work" property="quantityWork"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="name" property="name"/>
        <result column="remark" property="remark"/>
        <result column="date" property="date"/>
        <result column="project_id" property="projectId"/>
        <result column="remark" property="remark"/>
    </resultMap>


    <select id="findById" resultType="com.hzchum.scim.plan.core.api.pojo._do.EnclosurePlan">
        select *
        from enclosure_plan
        where bool_delete_enum = 0
          and category = #{category}
          and project_id = #{projectId}
    </select>

    <select id="selectSql" resultType="java.lang.String">
        ${sql}
    </select>
    <update id="updateSql">
        ${sql}
    </update>
</mapper>
