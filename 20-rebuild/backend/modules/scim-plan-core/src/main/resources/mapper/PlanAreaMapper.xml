    <select id="selectMaxMinDate" resultType="com.hzchum.scim.plan.core.api.pojo.dto.PlanMaxMinDateDTO">
        SELECT
        MIN(date) min_date ,
        MAX(date) max_date
        FROM plan_area
        WHERE bool_delete_enum = 0
        <if test="monomerId != null">
            AND monomer_id = #{monomerId}
        </if>
        <if test="areaProductType != null">
            AND product_type = #{areaProductType}
        </if>
    </select>
    <select id="getMachinePartByAreaList"
            resultType="com.hzchum.scim.plan.core.api.pojo._do.PlanArea">
        SELECT
        *
        FROM
        plan_area
        where bool_delete_enum=0
        AND id IN (SELECT
        par.area_id
        FROM
        mes_building_nest_cut_machine_part_separate sep
        LEFT JOIN tech_machine_part par ON sep.product_id = par.id
        WHERE
        sep.bool_delete_enum = 0
        <choose>
            <when test="cutIds!=null and cutIds.size()!=0">
                AND sep.nest_cut_id IN
                <foreach collection="cutIds" item="item" separator="," close=")" open="(">
                    #{item}
                </foreach>
            </when>
            <otherwise>
                AND sep.nest_cut_id is null
            </otherwise>
        </choose>
        <if test="projectIds != null and projectIds.size()>0">
            AND par.project_id IN
            <foreach collection="projectIds" index="id" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>

        )
    </select>
    <select id="getArtifactAndAssembleByAreaList" resultType="com.hzchum.scim.plan.core.api.pojo._do.PlanArea">
        SELECT
        *
        FROM
        plan_area
        WHERE
        bool_delete_enum = 0
        AND id IN (
        SELECT
        ta.area_id
        FROM
        mes_building_task task
        <if test=" taskTypeEnum==@com.hzchum.scim.mes.building.core.api.enums.ProductTypeEnum@ARTIFACT.getType()">LEFT
            JOIN tech_artifact ta ON task.product_id = ta.id
        </if>
        <if test="
        taskTypeEnum==@com.hzchum.scim.mes.building.core.api.enums.ProductTypeEnum@ASSEMBLE.getType()">LEFT JOIN
            tech_assemble ta ON task.product_id = ta.id
        </if>
            WHERE
                task.bool_delete_enum = 0
              AND task.task_type_enum = #{taskTypeEnum}
        <choose>
            <when test="assemblesTaskOrderIds!=null and assemblesTaskOrderIds.size()!=0">
                AND task.task_order_id IN
                <foreach collection="assemblesTaskOrderIds" item="item" separator="," close=")" open="(">
                    #{item}
                </foreach>
            </when>
            <otherwise>
                AND task.task_order_id is null
            </otherwise>
        </choose>
        )
    </select>

    <select id="getListByProjectId" resultType="com.hzchum.scim.plan.core.api.pojo.dto.ProjectPlanAreaDTO">
        SELECT
            pa.*,
            pa.type AS production_way,
            pa.mete AS budget_volume,
            pa.unit_name AS unit,
            pa.shipping_start_date AS shipped_start_date,
            pa.shipping_end_date AS shipped_end_date
        FROM plan_area pa
        WHERE pa.bool_delete_enum = FALSE
        <if test="projectId != null">
            AND pa.project_id = #{projectId}
        </if>
    </select>


</mapper>
