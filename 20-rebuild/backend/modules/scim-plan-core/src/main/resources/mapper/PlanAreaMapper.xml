<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.plan.core.mapper.PlanAreaMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.plan.core.api.pojo._do.PlanArea">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="name" property="name"/>
        <result column="date" property="date"/>
        <result column="project_id" property="projectId"/>
        <result column="monomer_id" property="monomerId"/>
        <result column="axis" property="axis"/>
        <result column="type" property="type"/>
        <result column="product_type" property="productType"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, name, date, project_id, monomer_id, axis, type, product_type, sort, remark
    </sql>

