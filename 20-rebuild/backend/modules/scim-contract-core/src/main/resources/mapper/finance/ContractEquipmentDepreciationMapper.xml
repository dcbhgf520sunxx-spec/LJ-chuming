<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.contract.core.mapper.finance.ContractEquipmentDepreciationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.contract.core.api.pojo._do.finance.ContractEquipmentDepreciation">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="classification_name" property="classificationName" />
        <result column="branch_company_id" property="branchCompanyId" />
        <result column="equipment_name" property="equipmentName" />
        <result column="original_value" property="originalValue" />
        <result column="depreciation_year" property="depreciationYear" />
        <result column="start_date" property="startDate" />
        <result column="end_date" property="endDate" />
        <result column="residual_value_rate" property="residualValueRate" />
        <result column="residual_value" property="residualValue" />
        <result column="year_depreciation_rate" property="yearDepreciationRate" />
        <result column="year_depreciation_amount" property="yearDepreciationAmount" />
        <result column="month_depreciation_rate" property="monthDepreciationRate" />
        <result column="month_depreciation_amount" property="monthDepreciationAmount" />
        <result column="user_id" property="userId" />
        <result column="bool_status" property="boolStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, classification_name, branch_company_id, equipment_name, original_value, depreciation_year, start_date, end_date, residual_value_rate, residual_value, year_depreciation_rate, year_depreciation_amount, month_depreciation_rate, month_depreciation_amount, user_id, bool_status
    </sql>

    <select id="listInfo" resultType="com.hzchum.scim.contract.core.api.pojo.dto.finance.ContractEquipmentDepreciationDTO">
        SELECT
            ced.*,
            sbc.name AS branch_company_name,
            su.name AS user_name
        FROM contract_equipment_depreciation ced
        LEFT JOIN sys_branch_company sbc ON sbc.bool_delete_enum = FALSE AND sbc.id = ced.branch_company_id
        LEFT JOIN sys_user su ON su.bool_delete_enum = FALSE AND su.id = ced.user_id
        WHERE ced.bool_delete_enum = FALSE
        <if test="branchCompanyId != null">
            AND ced.branch_company_id = #{branchCompanyId}
        </if>
        <if test="equipmentName != null and equipmentName != ''">
            <bind name="equipmentNameLike" value="'%' + equipmentName + '%'"/>
            AND ced.equipment_name like #{equipmentNameLike}
        </if>
        <if test="classificationName != null and classificationName != ''">
            AND ced.classification_name = #{classificationName}
        </if>
        <if test="boolStatus != null">
            AND ced.bool_status = #{boolStatus}
        </if>
    </select>

</mapper>
