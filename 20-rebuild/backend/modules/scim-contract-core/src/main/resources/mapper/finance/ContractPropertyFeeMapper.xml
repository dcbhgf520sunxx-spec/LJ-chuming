<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.contract.core.mapper.finance.ContractPropertyFeeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.contract.core.api.pojo._do.finance.ContractPropertyFee">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="year" property="year" />
        <result column="month" property="month" />
        <result column="year_month_value" property="yearMonthValue" />
        <result column="fee_amount" property="feeAmount" />
        <result column="attachment_ids" property="attachmentIds" />
        <result column="remark" property="remark" />
        <result column="user_id" property="userId" />
        <result column="bool_confirm_status" property="boolConfirmStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, year, month, year_month_value, fee_amount, attachment_ids, remark, user_id, bool_confirm_status
    </sql>

    <select id="selectMonthFeeList" resultType="com.hzchum.scim.common.core.api.pojo.common.MonthAmountInfo">
        SELECT year_month_value month,
               fee_amount amount
        FROM `contract_property_fee`
        WHERE bool_delete_enum = 0
          and year_month_value &gt; #{startMonth}
          and year_month_value &lt;= #{endMonth}
        order by year_month_value
    </select>

</mapper>
