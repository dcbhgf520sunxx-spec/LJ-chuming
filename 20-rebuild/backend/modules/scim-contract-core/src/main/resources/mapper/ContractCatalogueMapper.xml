<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.contract.core.mapper.ContractCatalogueMapper">

    <select id="listInfo" resultType="com.hzchum.scim.contract.core.api.pojo._do.ContractCatalogue">
        select *
        from contract_catalogue
        where bool_delete_enum = 0
        <if test="boolContractNumber != null">
            <if test="boolContractNumber == 0">
                AND contract_number IS NULL
            </if>
            <if test="boolContractNumber == 1">
                AND contract_number IS NOT NULL
            </if>
        </if>
        <if test="createSource != null">
            AND create_source = #{createSource}
        </if>
        <if test="contractNumber != null and contractNumber != ''">
            AND contract_number like concat('%',#{contractNumber},'%')
        </if>
        <if test="projectName != null and projectName != ''">
            AND project_name like concat('%',#{projectName},'%')
        </if>
        <if test="boolSupplement != null">
            AND bool_supplement = #{boolSupplement}
        </if>
        <if test="reviewStatus != null">
            AND review_status = #{reviewStatus}
        </if>
        order by create_time desc
    </select>
</mapper>