<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.contract.core.mapper.finance.SecurityDepositAndManagementCostMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.contract.core.api.pojo._do.finance.SecurityDepositAndManagementCost">
        <id column="id" property="id" />
        <result column="version" property="version" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="user_id" property="userId" />
        <result column="project_id" property="projectId" />
        <result column="income" property="income" />
        <result column="security_deduct_income" property="securityDeductIncome" />
        <result column="security_record" property="securityRecord" />
        <result column="management_deduct_income" property="managementDeductIncome" />
        <result column="management_record" property="managementRecord" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        version,
        create_time,
        update_time,
        bool_delete_enum,
        id, user_id, project_id, income, security_deduct_income, security_record, management_deduct_income, management_record
    </sql>

    <select id="pageSizeList" resultType="com.hzchum.scim.contract.core.api.pojo.dto.finance.SecurityDepositAndManagementCostDto">
        select *
        from security_deposit_and_management_cost
        where bool_delete_enum = 0
        <if test="projectId != null">
            and project_id = #{projectId}
        </if>
        order by date_time desc
    </select>

</mapper>
