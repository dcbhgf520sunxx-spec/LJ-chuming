<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.mes.building.core.mapper.factory.MesBuildingInspectionTeamUserLinkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.mes.building.core.api.pojo._doModel.factory.MesBuildingInspectionTeamUserLink">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="inspection_team_id" property="inspectionTeamId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, user_id, user_name,bool_leader_enum, inspection_team_id
    </sql>
    <select id="selectByCondition"
            resultType="com.hzchum.scim.mes.building.core.api.pojo._doModel.factory.MesBuildingInspectionTeamUserLink">
        SELECT
            b.*
        FROM
            mes_building_inspection_team a
                INNER JOIN mes_building_inspection_team_user_link b ON a.id = b.inspection_team_id
                AND b.bool_delete_enum = 0
        WHERE
            a.production_line_id = #{productionLineId}
          AND a.process_id = #{processId}
          AND a.bool_delete_enum =0
    </select>

</mapper>
