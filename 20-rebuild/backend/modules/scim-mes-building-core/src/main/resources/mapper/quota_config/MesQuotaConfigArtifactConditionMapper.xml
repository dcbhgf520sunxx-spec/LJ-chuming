<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.mes.building.core.mapper.quota_config.MesQuotaConfigArtifactConditionMapper">

    <delete id="deteleByQuotaConfigId">
        DELETE FROM mes_quota_config_artifact_condition
        WHERE quota_config_id = #{quotaConfigId}
    </delete>

    <select id="listByQuotaConfigIdList"
            resultType="com.hzchum.scim.mes.building.core.api.pojo._dto.quota_config.MesQuotaConfigArtifactConditionDTO">
        SELECT
            mqcac.*
        FROM mes_quota_config_artifact_condition mqcac
        WHERE mqcac.bool_delete_enum = 0
        AND mqcac.quota_config_id IN (
        <foreach collection="quotaConfigIdList" item="i" separator=",">
            #{i}
        </foreach>
        )
    </select>
</mapper>