<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.mes.building.core.mapper.scheduling.MesBuildingNeedMachinePartSchedulingMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.mes.building.core.api.pojo._doModel.scheduling.MesBuildingNeedMachinePartScheduling">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="link_task_type_enum" property="linkTaskTypeEnum" />
        <result column="product_id" property="productId" />
        <result column="quantity" property="quantity" />
        <result column="use_id" property="useId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        id, link_task_type_enum, product_id, quantity, use_id
    </sql>
    <select id="listByMonthList"
            resultType="com.hzchum.scim.mes.building.core.api.pojo._doModel.scheduling.MesBuildingNeedMachinePartScheduling">
        select * from mes_building_need_machine_part_scheduling sch
        LEFT JOIN tech_machine_part par ON sch.product_id = par.id AND par.bool_delete_enum=0
        WHERE sch.bool_delete_enum=false
        AND sch.need_quantity> sch.scheduling_quantity
        AND DATE_FORMAT(sch.need_scheduling_time,'%Y-%m') in
        <foreach collection="monthList" item="month" separator="," open="(" close=")">
            DATE_FORMAT(#{month},'%Y-%m')
        </foreach>
        AND par.bool_process =TRUE
    </select>

</mapper>
