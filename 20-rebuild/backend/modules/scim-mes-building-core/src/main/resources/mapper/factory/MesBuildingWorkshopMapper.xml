    </sql>
    <select id="listWorkShopUser" resultType="com.hzchum.scim.common.core.api.pojo.common.NameInfo">
        select id, name
        from mes_building_workshop
        where id in (select distinct t.factory_id
        from mes_building_team t
        inner join mes_building_team_user_link tu on tu.team_id = t.id
        where t.bool_delete_enum = 0
        and tu.bool_delete_enum = 0
        and tu.user_id = #{currentUserId}) and bool_delete_enum = 0
        and type=#{type}
        <if test="factoryId != null">
            and factory_id = #{factoryId}
        </if>
    </select>
    <select id="getWorkshopById"
            resultType="com.hzchum.scim.mes.building.core.api.pojo._doModel.factory.MesBuildingWorkshop">
        SELECT * FROM mes_building_workshop WHERE id=#{workshopId}
    </select>

