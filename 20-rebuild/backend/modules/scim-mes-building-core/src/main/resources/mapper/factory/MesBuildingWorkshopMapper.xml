    <select id="listShopLineLink"
            resultType="com.hzchum.scim.mes.building.core.api.pojo._dto.factory.MesWorkShopProctionLineDTO">
        SELECT
            wk.id shopId,
            wk.`name` shopName,
            line.id lineId,
            line.`name` lineName
        FROM
            mes_building_workshop wk
                LEFT JOIN mes_building_production_line line ON wk.id = line.workshop_id
        where wk.type = 1
          AND line.workshop_id is not NULL
    </select>
