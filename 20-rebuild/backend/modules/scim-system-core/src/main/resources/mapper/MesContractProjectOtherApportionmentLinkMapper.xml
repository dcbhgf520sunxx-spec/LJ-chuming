<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.MesContractProjectOtherApportionmentLinkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap"
               type="com.hzchum.scim.system.core.api.pojo._do.MesContractProjectOtherApportionmentLink">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="contract_project_id" property="contractProjectId"/>
        <result column="type" property="type"/>
        <result column="process_id" property="processId"/>
        <result column="unit" property="unit"/>
        <result column="price" property="price"/>
        <result column="status" property="status"/>
        <result column="factory_id" property="factoryId"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, contract_project_id, type, process_id, unit, price, status
    </sql>

    <select id="listInfo"
            resultType="com.hzchum.scim.system.core.api.pojo.dto.MesContractProjectOtherApportionmentLinkDTO">
        SELECT
            mcpoal.*,
            mbp.name AS process_name,
            mbf.name AS factory_name
        FROM mes_contract_project_other_apportionment_link mcpoal
        LEFT JOIN mes_building_process mbp ON mcpoal.process_id = mbp.id
        LEFT JOIN mes_building_factory mbf ON mbf.bool_delete_enum = FALSE and mbf.id = mcpoal.factory_id
        WHERE mcpoal.bool_delete_enum = FALSE AND mcpoal.contract_project_id = #{projectId}
    </select>

</mapper>
