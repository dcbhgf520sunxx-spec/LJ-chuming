<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.SysAssembleSpecMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.SysAssembleSpec">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="spec_prefix" property="specPrefix"/>
        <result column="assemble_config_id" property="assembleConfigId"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, spec_prefix, assemble_config_id
    </sql>

    <select id="selectByCondition" resultType="com.hzchum.scim.system.core.api.pojo.dto.AssembleSpecDTOParam">
        SELECT *
        FROM sys_assemble_spec
        WHERE bool_delete_enum = 0
        <if test="assembleConfigId != null">
            AND assemble_config_id = #{assembleConfigId}
        </if>
        <if test="specPrefix != null and specPrefix != ''">
            AND spec_prefix LIKE concat('%',#{specPrefix},'%')
        </if>
        <if test="mesProductEnum != null">
            AND mes_product_enum = #{mesProductEnum}
        </if>
    </select>


    <select id="getAssembleConfigToSpec" resultType="com.hzchum.scim.system.core.api.pojo.dto.AssembleSpecConfigDTOParam">
        SELECT
        sas.spec_prefix,
        sas.assemble_config_id AS id,
        sac.name,
        sac.bool_section_steel
        FROM sys_assemble_spec sas
        LEFT JOIN sys_assemble_config sac ON sac.id = sas.assemble_config_id AND sac.bool_delete_enum = 0
        WHERE sas.bool_delete_enum = 0
        <if test="assembleConfigIds != null and assembleConfigIds.size()>0">
            AND sas.assemble_config_id IN
            <foreach collection="assembleConfigIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>

</mapper>
