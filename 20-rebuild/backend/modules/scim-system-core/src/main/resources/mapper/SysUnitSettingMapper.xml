<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.SysUnitSettingMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.SysUnitSetting">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="basic_class" property="basicClass"/>
        <result column="length_retain" property="lengthRetain"/>
        <result column="length_unit" property="lengthUnit"/>
        <result column="thickness_retain" property="thicknessRetain"/>
        <result column="weight_retain" property="weightRetain"/>
        <result column="weight_unit" property="weightUnit"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        version,
        id, basic_class, length_retain, length_unit, thickness_retain, weight_retain, weight_unit
    </sql>

    <select id="listUnitSetting" resultType="com.hzchum.scim.system.core.api.pojo.dto.UnitSettingResponseVO">
        SELECT *
        FROM sys_unit_setting where bool_delete_enum = 0
    </select>


</mapper>
