<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.SysTablePrintTemplateMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.SysTablePrintTemplate">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="config" property="config"/>
        <result column="enabled" property="enabled"/>
        <result column="is_default" property="isDefault"/>
        <result column="name" property="name"/>
        <result column="remark" property="remark"/>
        <result column="type" property="type"/>
    </resultMap>

    <select id="listByType" resultType="com.hzchum.scim.system.core.api.pojo._do.SysTablePrintTemplate">
        SELECT *
        FROM sys_table_print_template
        WHERE type = #{type}
          and bool_delete_enum = 0
    </select>

    <select id="list" resultType="com.hzchum.scim.system.core.api.pojo._do.SysTablePrintTemplate">
        SELECT *
        FROM sys_table_print_template
        where bool_delete_enum = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%',#{name},'%')
        </if>
        <if test="type != null and type != ''">
            and type like CONCAT('%',#{type},'%')
        </if>
        <if test="enabled != null">
            AND enabled = #{enabled}
        </if>
    </select>


    <select id="listByTypes" resultType="com.hzchum.scim.system.core.api.pojo._do.SysTablePrintTemplate">
        SELECT *
        FROM sys_table_print_template
        WHERE bool_delete_enum = 0
        and type in
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

</mapper>
