<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.MenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.Menu">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="cache" property="cache"/>
        <result column="component" property="component"/>
        <result column="component_name" property="componentName"/>
        <result column="icon" property="icon"/>
        <result column="iframe" property="iframe"/>
        <result column="name" property="name"/>
        <result column="path" property="path"/>
        <result column="permission" property="permission"/>
        <result column="sort" property="sort"/>
        <result column="always_show" property="alwaysShow"/>
        <result column="category" property="category"/>
        <result column="hidden" property="hidden"/>
        <result column="permission_type_id" property="permissionTypeId"/>
        <result column="pid" property="pid"/>
        <result column="redirect" property="redirect"/>
        <result column="type" property="type"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        id, cache, component, component_name, icon, iframe, name, path, permission, sort, always_show, category, hidden, permission_type_id, pid, redirect, type
    </sql>

    <select id="listByIds" resultType="com.hzchum.scim.system.core.api.pojo._do.Menu">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_menu
        WHERE bool_delete_enum = 0

        <foreach collection="list" item="item" separator="," open=" and id IN (" close=")">
            #{item}
        </foreach>
        ORDER BY sort

    </select>
    <select id="listByCategory" resultType="com.hzchum.scim.system.core.api.pojo._do.Menu">
        SELECT *
        FROM sys_menu
        where bool_delete_enum = 0
        <if test="category != null">
            AND category = #{category}
        </if>
        ORDER BY sort,id
    </select>
    <select id="countByPermissionTypeId" resultType="java.lang.Integer">
        SELECT count(id)
        FROM sys_menu
        WHERE permission_type_id = #{permissionTypeId}
          and bool_delete_enum = 0
    </select>

    <select id="findByPid" resultType="com.hzchum.scim.system.core.api.pojo._do.Menu">
        SELECT *
        FROM sys_menu
        WHERE pid = #{pid}
          and bool_delete_enum = 0
        ORDER BY sort
    </select>

    <select id="listAllForUpdate" resultType="com.hzchum.scim.system.core.api.pojo._do.Menu">
        SELECT *
        FROM sys_menu FOR UPDATE
        where  bool_delete_enum = 0
    </select>

    <update id="changeIdAndPid">
        update `sys_menu` set id = id + 100000;
        update `sys_menu` set pid = pid + 100000 where pid &lt;&gt; 0;
        update `sys_role_menu_link` set menu_id = menu_id + 100000;
    </update>

    <select id="queryList" resultType="com.hzchum.scim.system.core.api.pojo._do.Menu">
        select * from sys_menu where `category` = #{category} and `type` = #{menuType}
    </select>

    <update id="updateMenuIdAndPid">
        UPDATE sys_menu SET id = #{newId} WHERE id = #{menu.id};
        UPDATE sys_menu SET pid = #{newId} WHERE pid = #{menu.id};
        UPDATE sys_role_menu_link SET menu_id = #{newId} WHERE menu_id = #{menu.id};
    </update>

</mapper>
