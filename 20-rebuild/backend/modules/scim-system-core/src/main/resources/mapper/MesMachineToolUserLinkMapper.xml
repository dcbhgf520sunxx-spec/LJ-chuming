<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.MesMachineToolUserLinkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.MesMachineToolUserLink">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="machine_tool_id" property="machineToolId" />
        <result column="user_id" property="userId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, machine_tool_id, user_id
    </sql>
    <select id="findUserInfoByCondition"
            resultType="com.hzchum.scim.plan.core.api.pojo.dto.change.SimpleUser">
        SELECT
            ul.machine_tool_id ,
            ul.user_id id,
            su.name
        FROM
            mes_machine_tool_config c
                LEFT JOIN mes_machine_tool_user_link ul ON c.id = ul.machine_tool_id
                LEFT JOIN sys_user su ON ul.user_id = su.id
        <where>
            c.bool_delete_enum = 0
            <if test="partProcessId != null">
                and c.part_process_id = #{partProcessId}
            </if>

            <if test="toolConfigIds != null and toolConfigIds.size > 0">
                and ul.machine_tool_id in
                <foreach collection="toolConfigIds" item="toolConfigId" separator="," close=")" open="(">
                    #{toolConfigId}
                </foreach>
            </if>

            <if test="userIds != null and userIds.size > 0">
                and ul.user_id in
                <foreach collection="userIds" item="userId" separator="," close=")" open="(">
                    #{userId}
                </foreach>
            </if>
        </where>


    </select>

</mapper>
