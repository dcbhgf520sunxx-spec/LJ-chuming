<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.SysDictionaryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="label" property="label"/>
        <result column="value" property="value"/>
        <result column="name" property="name"/>
        <result column="remark" property="remark"/>
        <result column="sort" property="sort"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, label, value, name, remark, sort
    </sql>


    <select id="listByNameAndLabelLike" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT *
        FROM sys_dictionary
        WHERE bool_delete_enum = 0
        and name = #{name}
        <if test="label != null and label != ''">
            AND label LIKE concat('%',#{label},'%')
        </if>
        ORDER BY sort
    </select>

    <select id="listAllDictionary"
            resultType="com.hzchum.scim.system.core.api.pojo.dto.SysDictionaryDetailDTO">
        SELECT *
        FROM sys_dictionary
        where bool_delete_enum = 0
        <if test="blurry!= null and blurry != ''">
            and (name like concat('%',#{blurry},'%') or remark like concat('%',#{blurry},'%'))
        </if>
    </select>

    <select id="listByNameAndValue" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT * FROM sys_dictionary
        WHERE name = #{name}
        and bool_delete_enum = 0
        <if test="value != null and value != ''">
            AND value = #{value}
        </if>
        ORDER BY sort
    </select>

    <select id="getByNameAndLabel" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT *
        FROM sys_dictionary
        WHERE name = #{name}
          AND label = #{label}
          and bool_delete_enum = 0
    </select>

    <select id="getByNameAndValue" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT *
        FROM sys_dictionary
        WHERE name = #{name}
          AND value = #{value}
          and bool_delete_enum = 0
    </select>

    <select id="getByNameAndValueV2" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT *
        FROM sys_dictionary
        WHERE name = #{currencyType}
          AND id = #{value}
          and bool_delete_enum = 0
    </select>

    <select id="selectByConditions" resultType="string">
        select label
        from sys_dictionary
        where bool_delete_enum = 0
        and name = #{name}
        and value in
        <foreach collection="valueList" open="(" separator="," close=")" item="value">
            #{value}
        </foreach>

    </select>

    <select id="moreDistNameAndLabelLike" resultType="com.hzchum.scim.system.core.api.pojo._do.SysDictionary">
        SELECT *
        FROM sys_dictionary
        WHERE bool_delete_enum = 0
        and name in
        <foreach collection="names" open="(" separator="," close=")" item="value">
            #{value}
        </foreach>
        ORDER BY sort
    </select>
</mapper>
