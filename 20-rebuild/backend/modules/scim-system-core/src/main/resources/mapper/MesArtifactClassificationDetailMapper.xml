<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.system.core.mapper.MesArtifactClassificationDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.system.core.api.pojo._do.MesArtifactClassificationDetail">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="bool_delete_enum" property="boolDeleteEnum" />
        <result column="version" property="version" />
        <result column="artifact_classification_id" property="artifactClassificationId" />
        <result column="name_or_type" property="nameOrType" />
        <result column="index_id" property="indexId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time,
        update_time,
        bool_delete_enum,
        version,
        id, artifact_classification_id, name_or_type, index_id
    </sql>

    <delete id="deleteByArtifactClassificationId">
        DELETE FROM mes_artifact_classification_detail WHERE artifact_classification_id = #{artifactClassificationId}
    </delete>

</mapper>
