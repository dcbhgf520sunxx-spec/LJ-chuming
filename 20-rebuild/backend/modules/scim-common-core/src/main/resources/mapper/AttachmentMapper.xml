<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.common.core.mapper.AttachmentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.common.core.api.pojo._do.Attachment">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="name" property="name"/>
        <result column="thumbnail_path" property="thumbnailPath"/>
        <result column="relative_path" property="relativePath"/>
        <result column="type" property="type"/>
        <result column="media_type" property="mediaType"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, name, thumbnail_path, relative_path, type, media_type
    </sql>
    <select id="listByIds" resultType="com.hzchum.scim.common.core.api.pojo._do.Attachment">
        select *
        from attachment
        where find_in_set(id, #{ids})
    </select>

</mapper>
