    <select id="selectSubSupplier" resultType="com.hzchum.scim.project.core.api.pojo.dao.ProjectSupplierAccountDO">
        SELECT
        temp.supplier_id ,
        (select name from scm_supplier where bool_delete_enum = 0 and id = temp.supplier_id) as supplier_name ,
        psa.username ,
        psa.`password`
        FROM
        (
        SELECT
        supplier_id
        FROM
        project_supplier_area_link
        WHERE
        bool_delete_enum = 0
        AND project_id = #{projectId}
        <if test="monomerId != null">
            AND monomer_id = #{monomerId}
        </if>
        GROUP BY supplier_id
        ) AS temp
        INNER JOIN project_supplier_account AS psa ON temp.supplier_id = psa.supplier_id AND psa.bool_delete_enum = 0
        ORDER BY psa.bool_status DESC , psa.supplier_id ASC
    </select>

</mapper>
