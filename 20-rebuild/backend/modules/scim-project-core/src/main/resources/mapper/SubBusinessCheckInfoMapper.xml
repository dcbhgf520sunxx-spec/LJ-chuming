<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.project.core.mapper.SubBusinessCheckInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hzchum.scim.project.core.api.pojo._do.SubBusinessCheckInfo">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="bool_delete_enum" property="boolDeleteEnum"/>
        <result column="version" property="version"/>
        <result column="status" property="status"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="check_user_id" property="checkUserId"/>
        <result column="check_user_name" property="checkUserName"/>
        <result column="check_time" property="checkTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, status, create_user_id, create_user_name, check_user_id, check_user_name, check_time, remark
    </sql>
    <select id="listInfo" resultType="com.hzchum.scim.business.core.api.pojo.dto.CheckInfoDTO">
        select i.*,
        p.id 'project.id',
        p.name 'project.name',
        p.short_name 'project.short_name',
        p.serial_number 'project.contract_no',
        m.id 'monomer.id',
        m.name 'monomer.name'
        from project_sub_business_check_info i
        inner join contract_project p on p.id = i.project_id
        inner join plan_monomer m on m.id = i.monomer_id
        <where>
            <if test="projectId != null">
                and i.project_id = #{projectId}
            </if>
            <if test="status != null">
                and i.status = #{status}
            </if>
        </where>
        order by i.create_time desc
    </select>
</mapper>
