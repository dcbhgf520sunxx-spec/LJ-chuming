<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzchum.scim.wms.core.mapper.wmsConfig.WarningMapper">


    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        create_time
        ,
        update_time,
        bool_delete_enum,
        version,
        id, serial_number, subject_id, spec, unit, unit_config, unit_precision, quantity
    </sql>

    <resultMap id="list" type="com.hzchum.scim.wms.core.api.pojo.dto.wmsConfig.WarningDTO">
        <id column="id" property="id"/>
        <result column="classification_id" property="classifyId"/>
        <result column="specification" property="specification"/>
        <result column="unit" property="unit"/>
        <result column="unit_type" property="unitType"/>
        <result column="minimum_inventory" property="minimumInventory"/>
        <result column="enabled" property="enabled"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <association property="workshop"
                     javaType="com.hzchum.scim.wms.core.api.pojo.dto.common.BriefIdAndNameDTO">
            <id property="id" column="mbfId"/>
            <result property="name" column="mbfName"/>
        </association>
    </resultMap>
    <select id="list" resultMap="list">
        select ww.*,
               mbf.id   mbfId,
               mbf.name mbfName
        from wms_warning ww
        left join wms_workshop mbf on ww.workshop_id = mbf.id
        where ww.bool_delete_enum = 0
        <if test="ids != null and ids.size()>0">
            and ww.classification_id in
            <foreach collection="ids" index="id" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="classificationId != null">
            and ww.classification_id = #{classificationId}
        </if>
        <if test="workshopId != null ">
            and ww.workshop_id = #{workshopId}
        </if>
        <if test="specification != null ">
            AND ww.specification = #{specification}
        </if>
    </select>

</mapper>
