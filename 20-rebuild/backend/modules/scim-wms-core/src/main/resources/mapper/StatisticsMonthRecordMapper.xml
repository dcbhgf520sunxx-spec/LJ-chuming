    <select id="getListById" resultMap="getList">
        select
        wsmr.id,
        wsmr.wap_id,
        wsmr.specs,
        wsmr.basic_class,
        wsmr.classify_id,
        wsmr.project_id,
        wsmr.thickness,
        wsmr.theory_thickness,
        wsmr.brand,
        wsmr.color,
        wsmr.heat_no_and_batch_no,
        wsmr.unit_net,
        wsmr.bool_party_a,
        wsmr.invoice_type,
        wsmr.tax_rate,
        wsmr.weighted_price_type,
        wsmr.standard_id,
        wsmr.standard_name,
        wsmr.total_quantity,
        wsmr.total_mete,
        wsmr.inbound_mete,
        wsmr.inbound_quantity,
        wsmr.transfer_mete,
        wsmr.transfer_quantity,
        wsmr.outbound_mete,
        wsmr.outbound_quantity,
        wsmr.end_mete,
        wsmr.end_quantity,
        <if test="boolShowAmount">
            wsmr.inbound_amount,
            wsmr.inbound_amount_excluding_vat,
            wsmr.inbound_unit_price,
            wsmr.inbound_unit_price_excluding_vat,
            wsmr.outbound_amount,
            wsmr.outbound_amount_excluding_vat,
            wsmr.outbound_unit_price,
            wsmr.outbound_unit_price_excluding_vat,
            wsmr.end_amount,
            wsmr.end_amount_excluding_vat,
            wsmr.end_unit_price,
            wsmr.end_unit_price_excluding_vat,
            wsmr.transfer_amount,
            wsmr.transfer_amount_excluding_vat,
            wsmr.transfer_unit_price,
            wsmr.transfer_unit_price_excluding_vat,
        </if>
        wsmr.create_time,
        wsmr.update_time,
        wsmr.bool_delete_enum,
        wsmr.version,
        wsmr.specification,
        wsmr.stat_id,
        wc.name className,
        p.id pid,
        p.short_name psName,
        p.serial_number pSN,
        p.name pn,
        wm.id wmId,
        wm.measure_unit measureUnit,
        wm.measure_precision measurePrecision,
        wm.accounting_unit accountingUnit,
        wm.accounting_precision accountingPrecision,
        wm.outbound_unit_type outboundUnitType,
        wm.rd_rate rdRate
        from wms_statistics_month_record wsmr
        left join contract_project p on p.id = wsmr.project_id
        left join wms_classification wc on wsmr.classify_id = wc.id
        left join wms_measure wm on wsmr.classify_id = wm.classification_id
        <where>
            wsmr.bool_delete_enum = 0
            <if test="basicClass != null ">
                AND wsmr.basic_class = #{basicClass}
            </if>
            <if test="orderSupplyType == 2 ">
                and wsmr.bool_party_a = 1
            </if>
            <if test="orderSupplyType == 1 ">
                and wsmr.bool_party_a = 0
            </if>
            <if test="classifyIds != null and classifyIds.size()>0">
                and wsmr.classify_id in
                <foreach collection="classifyIds" index="id" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
<!--            <if test="classifyIds == null and  classifyId != null">-->
<!--                and wsmr.classify_id = #{classifyId}-->
<!--            </if>-->
            <if test="projectWarehouseType == 1 ">
                and wsmr.project_id is null
            </if>
            <if test="projectWarehouseType == 2 ">
                and wsmr.project_id IS NOT NULL
            </if>
            <if test="projectId != null ">
                AND wsmr.project_id = #{projectId}
            </if>
            <if test=" color != null">
                and wsmr.color like CONCAT('%', #{color},'%')
            </if>
            <if test=" specification != null and specification != ''">
                and wsmr.specs like CONCAT('%', #{specification},'%')
            </if>
            <if test=" heatNoAndBatchNo != null and heatNoAndBatchNo != ''">
                and wsmr.heat_no_and_batch_no like CONCAT('%', #{heatNoAndBatchNo},'%')
            </if>
            <if test="brand != null and brand != ''">
                AND wsmr.brand like CONCAT('%',#{brand},'%')
            </if>
            <if test="createTime != null and wmsClosingTimeId==null">
                AND date_format(DATE_ADD(wsmr.create_time, INTERVAL -1 month), '%y-%m') = date_format(#{createTime},'%y-%m')
            </if>
            <if test="wmsClosingTimeId !=null and wmsClosingTimeId!=''">
                and   wsmr.wms_closing_time_id=#{wmsClosingTimeId}
            </if>
        </where>
    </select>


</mapper>
