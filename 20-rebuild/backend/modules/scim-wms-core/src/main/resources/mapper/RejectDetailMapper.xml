            AND wrd.brand like CONCAT('%', #{brand},'%')
        </if>
        <if test=" workshopIds != null and workshopIds.size() > 0">
            and wrd.workshop_id in
            <foreach collection="workshopIds" index="id" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        order by wrd.id desc
    </select>
    <select id="getDetailByInboundDetailIds"
            resultType="com.hzchum.scim.wms.core.api.pojo._do.wmsUse.RejectDetail">
        select  wrd.*
        from wms_reject_detail wrd
                 left join wms_reject wr on wr.id = wrd.reject_id
        where
            wrd.inbound_detail_id in
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                 #{id}
            </foreach>
          and wr.review_status = 2
          and wr.bool_delete_enum = 0
          and wrd.bool_delete_enum = 0

    </select>
    <select id="selectPassDetailByInboundDetailIds"
            resultType="com.hzchum.scim.wms.core.api.pojo._do.wmsUse.RejectDetail">
        select  wrd.*
        from wms_reject_detail wrd
                 left join wms_reject wr on wr.id = wrd.reject_id and wr.bool_delete_enum = 0
        where
            wrd.bool_delete_enum = 0
        and wr.review_status = 2
        and wrd.inbound_detail_id in
            <foreach collection="inboundDetailIds" item="id" open="(" separator="," close=")">
                 #{id}
            </foreach>
    </select>

    <select id="selectCountMeteAndAmount"
            resultType="com.hzchum.scim.common.core.api.pojo.dto.BasicClassMeteAndAmountDTO">
        select
        wrd.basic_class basicClass,
        sum(wrd.mete) mete,
        sum(wrd.amount) amount,
        DATE_FORMAT(wr.review_time, '%Y/%m') time
        from wms_reject_detail wrd
        left join wms_reject wr ON wrd.reject_id = wr.id and wr.bool_delete_enum = 0
        where wrd.bool_delete_enum = 0
        <if test="reviewStatus != null and reviewStatus != ''">
            and wr.review_status = #{reviewStatus}
        </if>
        <if test="basicClass != null">
            and wrd.basic_class = #{basicClass}
        </if>
        <if test="timeList != null and timeList.size > 0">
            and
            <foreach collection="timeList" item="time" open="(" separator=" or " close=")">
                DATE_FORMAT(wr.review_time, '%Y/%m') = #{time}
            </foreach>
        </if>
        <if test="projectId != null">
            and wrd.project_id = #{projectId}
        </if>
        <if test="projectId == null">
            and wrd.project_id is null
        </if>
        <if test="notClassifyIds != null and notClassifyIds.size > 0">
            and wrd.classify_id not in
            <foreach collection="notClassifyIds" item="classifyId" open="(" separator="," close=")">
                #{classifyId}
            </foreach>
        </if>
        <if test="getClassifyIds != null and getClassifyIds.size > 0">
            and wrd.classify_id in
            <foreach collection="getClassifyIds" item="classifyId" open="(" separator="," close=")">
                #{classifyId}
            </foreach>
        </if>
        group by wrd.basic_class,DATE_FORMAT(wr.review_time, '%Y/%m')

    </select>
    <select id="getPurchaseRejectMete" resultType="com.hzchum.scim.wms.core.api.pojo.dto.common.ReceiptMeteDTO">
        select
        wr.purchase_order_id as id,
        IFNULL(sum(wrd.mete),0) as mete
        from wms_reject_detail wrd
        left join wms_reject wr on wrd.reject_id = wr.id
        where
        wrd.bool_delete_enum = 0
        and wr.review_status  = 2
        <if test="purchaseIds != null and purchaseIds.size > 0">
            and wr.purchase_order_id in
            <foreach collection="purchaseIds" item="purchaseId" open="(" separator="," close=")">
                #{purchaseId}
            </foreach>
        </if>
        group by wr.purchase_order_id
    </select>
    <select id="selectPassDetail" resultType="com.hzchum.scim.wms.core.api.pojo._do.wmsReport.RejectDetailDO">
        select
            wrd.amount  amount,
            wrd.amount_excluding_vat amountExcludingVat,
            wrd.basic_class basicClass,
            wr.review_time reviewTime
        from wms_reject_detail wrd
        left join wms_reject wr on wr.id = wrd.reject_id and wr.bool_delete_enum = 0 and wr.review_status = 2
        where
            wrd.bool_delete_enum = 0
        <if test="workshopId != null and workshopId != ''">
            and wrd.workshop_id = #{workshopId}
        </if>
        <if test="startDay != null">
            and wr.review_time &gt;= #{startDay}
        </if>
        <if test="endDay != null">
            and wr.review_time &lt;= #{endDay}
        </if>
    </select>

</mapper>
