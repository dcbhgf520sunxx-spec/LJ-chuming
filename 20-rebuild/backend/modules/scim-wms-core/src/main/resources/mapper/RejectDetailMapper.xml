    <select id="getDetailDTO" resultType="com.hzchum.scim.wms.core.api.pojo.dto.wmsReport.DetailDTO">
        select ifnull(sum(ifnull(wrd.mete, 0)), 0)                 mete,
               ifnull(sum(ifnull(wrd.quantity, 0)), 0)             quantity,
               ifnull(sum(ifnull(wrd.input_VAT, 0)), 0)            inputVAT,
               ifnull(sum(ifnull(wrd.amount, 0)), 0)               amount,
               ifnull(sum(ifnull(wrd.amount_excluding_VAT, 0)), 0) amountExcludingVAT,
               ifnull((select unit_price_excluding_VAT
                       from wms_reject_detail
                       order by create_time desc LIMIT 1),0)       unitPriceExcludingVAT
        from wms_reject_detail wrd
                 left join wms_reject wr on wr.id = wrd.reject_id
        where wrd.weighted_average_price_id = #{wapId}
          and wr.review_status = 2
          and wrd.bool_delete_enum = 0
    </select>

