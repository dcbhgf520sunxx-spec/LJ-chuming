    <select id="getByReId" resultMap="getByReId">
        select wrd.*,
               p.id            pid,
               p.short_name    psName,
               p.serial_number pSN,
               p.name          pn,
               mbf.id          mbfId,
               mbf.name        mbfName,
               pm.name                  pmName,
               pa.name                  paName,
               ww.id           wwId,
               ww.name         wwName,
               wm.measure_unit wmu,
               wm.measure_precision wmp,
               wm.accounting_unit wau,
               wm.accounting_precision wap,
               wid.mete        wm,
               wid.quantity    wq
        from wms_reject_detail wrd
                 left join contract_project p on p.id = wrd.project_id
                 left join wms_workshop mbf on wrd.workshop_id = mbf.id
                 left join wms_warehouse ww on ww.id = wrd.warehouse_id
                 left join wms_inbound_detail wid on wid.id = wrd.inbound_detail_id
                 left join wms_measure wm on wm.classification_id = wrd.classify_id
                 left join plan_monomer pm on pm.id = wrd.monomer_id
                 left join plan_area pa on pa.id = wrd.area_id
        where wrd.bool_delete_enum = 0
          and wrd.reject_id = #{id}

    </select>

    <select id="getDetailByInboundDetailId" resultType="com.hzchum.scim.wms.core.api.pojo._do.wmsUse.RejectDetail">
        select  wrd.*
        from wms_reject_detail wrd
                 left join wms_reject wr on wr.id = wrd.reject_id
        where wrd.inbound_detail_id = #{id}
          and wr.review_status = 2
          and wr.bool_delete_enum = 0
          and wrd.bool_delete_enum = 0

    </select>

    <select id="getByYear" resultType="java.math.BigDecimal">
        select ifnull(sum(a.mete),0)
        from wms_reject_detail a
                left join wms_reject b on b.id = a.reject_id
        where
           b.review_status = 2
          and b.bool_delete_enum = 0
          and a.bool_delete_enum = 0
          and a.basic_class &amp; #{basicClass} &gt; 0
          and DATE_FORMAT(a.create_time, '%Y%m') = #{year}
    </select>

    <select id="getList" resultMap="RejectDetailDO">
        select
        wr.review_time rejectTime,
        wr.review_time reviewTime,
        cp.id projectId,
        cp.name projectName,
        wr.serial_number rejectSN,
        wr.id rejectId,
        spo.id purchaseId,
        spo.serial_number purchaseInboundSN,
        wi.id inboundID,
        wi.serial_number inboundSN,
        cp.short_name    projectShortName,
        cp.serial_number projectSN,
        ss.name supplierName,
        wr.applicant_name applicantName,
        wr.create_time createTime,
        wr.editor_name editorName,
        wr.reviewer_name reviewerName,
        wrd.*,
        ww.id warehouseId,
        ww.name warehouseName,
        mf.name workshopName
        from wms_reject_detail wrd
        left join wms_reject wr on wr.id = wrd.reject_id
        left join wms_inbound wi on wi.id = wr.inbound_id
        left join wms_warehouse ww on ww.id = wrd.warehouse_id
        left join wms_workshop mf on mf.id = wrd.workshop_id
        left join scm_supplier ss on ss.id = wr.supplier_id
        left join scm_purchase_order spo on spo.id = wr.purchase_order_id
        left join contract_project cp on cp.id = wrd.project_id
        where
        wrd.bool_delete_enum = 0
        and wr.review_status = 2
        <if test="basicClass != null and basicClass != ''">
            and wrd.basic_class &amp; #{basicClass} &gt; 0
        </if>
        <if test="supplierId != null and supplierId != ''">
            and wr.supplier_id = #{supplierId}
        </if>
        <if test="warehouseId != null and warehouseId != ''">
            and wrd.warehouse_id = #{warehouseId}
        </if>
        <if test="projectWarehouseType == 1 ">
            and wrd.project_id is null
        </if>
        <if test="projectWarehouseType == 2 ">
            and wrd.project_id IS NOT NULL
        </if>
        <if test="rejectSN != null and rejectSN != '' ">
            and wr.serial_number like CONCAT('%', #{rejectSN},'%')
        </if>
        <if test="purchaseSN != null and purchaseSN != '' ">
            and wr.purchase_sn like CONCAT('%', #{purchaseSN},'%')
        </if>
        <if test="inboundSN != null and inboundSN != '' ">
            and wr.inbound_sn like CONCAT('%', #{inboundSN},'%')
        </if>
        <if test=" operatorName != null and  operatorName != ''">
            and (wr.editor_name like CONCAT('%', #{operatorName},'%')
            or wr.applicant_name like CONCAT('%', #{operatorName},'%')
            or wr.reviewer_name like CONCAT('%', #{operatorName},'%'))
        </if>
        <if test="projectId != null and projectId != ''">
            AND wrd.project_id = #{projectId}
        </if>
        <if test="classifyIds != null and classifyIds.size()>0">
            and wrd.classify_id in
            <foreach collection="classifyIds" index="id" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="reviewTime != null and reviewTime.size()>0">
            <if test="reviewTime[0] != null">
                and wr.review_time &gt; #{reviewTime[0]}
            </if>
            <if test="reviewTime[1] != null">
                and wr.review_time &lt; #{reviewTime[1]}
            </if>
        </if>
        <if test="rejectTime != null and rejectTime.size()>0">
            <if test="rejectTime[0] != null">
                and wr.review_time &gt;= #{rejectTime[0]}
            </if>
            <if test="rejectTime[1] != null">
                and wr.review_time &lt;= #{rejectTime[1]}
            </if>
        </if>
        <if test=" specification != null and specification != ''">
            and wrd.specification like CONCAT('%', #{specification},'%')
        </if>
        <if test="brand != null and brand != ''">
            AND wrd.brand like CONCAT('%', #{brand},'%')
        </if>
        <if test=" workshopIds != null and workshopIds.size() > 0 ">
            and wrd.workshop_id in
            <foreach collection="workshopIds" index="id" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>


